// Scaffold + Workspace Phase 2 + Documents + AIJob extract + Phase 5A-1 Chat foundation.
// Matter.workspaceId remains legacy nullable without FK until a later contract drop (W-003).
// MFA/SSO (O-008) / grant / DocumentVersion / ContextSnapshot / chat API — later slices.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  active
  suspended

  @@map("organization_status")
}

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

enum MembershipRole {
  owner
  admin
  member

  @@map("membership_role")
}

enum MembershipStatus {
  active
  revoked

  @@map("membership_status")
}

enum WorkspaceVisibility {
  PERSONAL
  TEAM

  @@map("workspace_visibility")
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
  PENDING_DELETION
  DELETING
  DELETED

  @@map("workspace_status")
}

enum WorkspaceMemberRole {
  EDITOR
  VIEWER

  @@map("workspace_member_role")
}

enum WorkspaceMemberStatus {
  ACTIVE
  REVOKED

  @@map("workspace_member_status")
}

/// Lifecycle for uploaded files (docs/06 §5.1). `uploading` = two-phase put (hardening).
enum DocumentStatus {
  uploading
  uploaded
  processing
  ready
  processing_failed
  archived
  deletion_pending
  deleted

  @@map("document_status")
}

/// AIJob statuses — CONFIRMED D-011 only.
enum AiJobStatus {
  queued
  running
  succeeded
  failed
  cancelled
  timed_out

  @@map("ai_job_status")
}

/// Chat visibility inside a Workspace (W-007).
enum ConversationVisibility {
  PRIVATE
  WORKSPACE

  @@map("conversation_visibility")
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED

  @@map("conversation_status")
}

enum MessageRole {
  user
  assistant

  @@map("message_role")
}

/// Business status of one AiGeneration run (does not replace AiJobStatus / D-011).
enum AiGenerationStatus {
  queued
  running
  succeeded
  failed
  cancelled
  timed_out

  @@map("ai_generation_status")
}

/// ContextSnapshotItem kinds (docs/19 / docs/32). Phase 5B uses conversation_message only.
enum ContextSnapshotItemType {
  conversation_message
  document_chunk
  legal_evidence
  workspace_instruction
  organization_instruction
  tool_result
  summary

  @@map("context_snapshot_item_type")
}

/// Server-authored citation link on an assistant message (docs/32 §5.5).
enum MessageSourceType {
  conversation_message
  document
  document_chunk
  legal
  synthetic

  @@map("message_source_type")
}

model Organization {
  id           String                     @id @default(uuid()) @db.Uuid
  name         String
  status       OrganizationStatus         @default(active)
  createdAt    DateTime                   @default(now()) @map("created_at")
  updatedAt    DateTime                   @updatedAt @map("updated_at")
  clients      Client[]
  matters      Matter[]
  memberships  OrganizationMembership[]
  sessions     Session[]
  workspaces   Workspace[]
  invitations  OrganizationInvitation[]
  documents     Document[]
  aiJobs        AiJob[]
  extractions   DocumentExtraction[]
  auditEvents   AuditEvent[]
  conversations        Conversation[]
  messages             Message[]
  aiGenerations        AiGeneration[]
  outboxEvents         OutboxEvent[]
  contextSnapshots     ContextSnapshot[]
  contextSnapshotItems ContextSnapshotItem[]
  messageSources       MessageSource[]

  @@map("organizations")
}

model Client {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  status         String       @default("active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  matters        Matter[]
  workspaces     Workspace[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("clients")
}

model Matter {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clientId       String?          @map("client_id") @db.Uuid
  client         Client?          @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict)
  /// Legacy scaffold field (nullable, no FK). Prefer WorkspaceMatter (W-003); drop in a later contract migration after backfill.
  workspaceId    String?          @map("workspace_id") @db.Uuid
  title          String
  status         String           @default("active")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  workspaceLinks WorkspaceMatter[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("matters")
}

model User {
  id                 String                   @id @default(uuid()) @db.Uuid
  email              String                   @unique
  passwordHash       String                   @map("password_hash")
  status             UserStatus               @default(active)
  lastLoginAt        DateTime?                @map("last_login_at")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  memberships        OrganizationMembership[]
  sessions           Session[]
  ownedWorkspaces    Workspace[]              @relation("WorkspaceOwner")
  workspaceMembers   WorkspaceMember[]
  workspaceMatters   WorkspaceMatter[]        @relation("WorkspaceMatterCreator")
  addedMembers       WorkspaceMember[]        @relation("WorkspaceMemberAdder")
  invitationsSent    OrganizationInvitation[]  @relation("InvitationInviter")
  uploadedDocuments      Document[]       @relation("DocumentUploader")
  createdAiJobs          AiJob[]          @relation("AiJobCreator")
  ownedConversations     Conversation[]   @relation("ConversationOwner")
  createdConversations   Conversation[]   @relation("ConversationCreator")
  createdMessages        Message[]        @relation("MessageCreator")

  @@map("users")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String           @map("user_id") @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  role           MembershipRole   @default(member)
  status         MembershipStatus @default(active)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

/// Org invitation (W-012). Owner role cannot be granted via invite. TTL from config (O-011).
/// Raw token never stored — only SHA-256 hash.
model OrganizationInvitation {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  emailNormalized String         @map("email_normalized")
  /// Invitable roles only: admin | member (not owner).
  role            MembershipRole
  tokenHash       String         @unique @map("token_hash")
  invitedByUserId String         @map("invited_by_user_id") @db.Uuid
  invitedBy       User           @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  expiresAt       DateTime       @map("expires_at")
  acceptedAt      DateTime?      @map("accepted_at")
  revokedAt       DateTime?      @map("revoked_at")
  lastSentAt      DateTime?      @map("last_sent_at")
  sendCount       Int            @default(1) @map("send_count")

  @@index([organizationId, emailNormalized])
  @@index([organizationId, createdAt])
  @@map("organization_invitations")
}

/// Opaque browser session; raw token never stored — only SHA-256 hash.
/// organizationId is the actor org bound at login (scaffold; not a full org-switcher).
model Session {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tokenHash      String       @unique @map("token_hash")
  expiresAt      DateTime     @map("expires_at")
  revokedAt      DateTime?    @map("revoked_at")
  lastSeenAt     DateTime?    @map("last_seen_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([userId])
  @@index([organizationId])
  @@map("sessions")
}

/// Workspace (W-001). PERSONAL/TEAM (W-002). Optional Client 0..1 (W-004). OWNER via ownerUserId (W-006).
model Workspace {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ownerUserId    String              @map("owner_user_id") @db.Uuid
  owner          User                @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  name           String
  description    String?
  visibility     WorkspaceVisibility
  status         WorkspaceStatus     @default(ACTIVE)
  clientId       String?             @map("client_id") @db.Uuid
  client         Client?             @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  archivedAt     DateTime?           @map("archived_at")
  members        WorkspaceMember[]
  matterLinks    WorkspaceMatter[]
  documents        Document[]
  conversations    Conversation[]
  contextSnapshots ContextSnapshot[]

  @@unique([organizationId, id])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, ownerUserId, status])
  @@index([organizationId, clientId])
  @@map("workspaces")
}

model WorkspaceMember {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  workspaceId    String                @map("workspace_id") @db.Uuid
  workspace      Workspace             @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  userId         String                @map("user_id") @db.Uuid
  user           User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  role           WorkspaceMemberRole
  status         WorkspaceMemberStatus @default(ACTIVE)
  addedByUserId  String?               @map("added_by_user_id") @db.Uuid
  addedBy        User?                 @relation("WorkspaceMemberAdder", fields: [addedByUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  revokedAt      DateTime?             @map("revoked_at")

  @@unique([workspaceId, userId])
  @@index([organizationId, workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

/// M:N Workspace ↔ Matter (W-003).
model WorkspaceMatter {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  workspace       Workspace @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  matterId        String   @map("matter_id") @db.Uuid
  matter          Matter   @relation(fields: [organizationId, matterId], references: [organizationId, id], onDelete: Cascade)
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdBy       User?    @relation("WorkspaceMatterCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, matterId])
  @@index([organizationId, workspaceId])
  @@index([organizationId, matterId])
  @@map("workspace_matters")
}

/// Uploaded file metadata. Binary lives in private object storage by storageKey.
/// Flattened single version; DocumentVersion table later.
model Document {
  id               String              @id @default(uuid()) @db.Uuid
  organizationId   String              @map("organization_id") @db.Uuid
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspaceId      String              @map("workspace_id") @db.Uuid
  workspace        Workspace           @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  title            String
  status           DocumentStatus      @default(uploaded)
  originalFileName String              @map("original_file_name")
  mimeType         String              @map("mime_type")
  byteSize         Int                 @map("byte_size")
  checksumSha256   String              @map("checksum_sha256")
  storageKey       String              @map("storage_key")
  uploadedByUserId String              @map("uploaded_by_user_id") @db.Uuid
  uploadedBy       User                @relation("DocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  aiJobs           AiJob[]
  extraction       DocumentExtraction?

  @@unique([organizationId, id])
  @@index([organizationId, workspaceId, createdAt])
  @@index([organizationId, status])
  @@map("documents")
}

/// Background job source of truth (D-011 / D-027). BullMQ is delivery only.
model AiJob {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspaceId     String?      @map("workspace_id") @db.Uuid
  documentId      String?      @map("document_id") @db.Uuid
  document        Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  createdBy       User         @relation("AiJobCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  type            String
  status          AiJobStatus  @default(queued)
  idempotencyKey  String       @map("idempotency_key")
  attemptCount    Int          @default(0) @map("attempt_count")
  maxAttempts     Int          @default(3) @map("max_attempts")
  lastErrorCode   String?      @map("last_error_code")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  startedAt       DateTime?    @map("started_at")
  completedAt     DateTime?    @map("completed_at")
  extractions     DocumentExtraction[]
  aiGeneration    AiGeneration?

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([documentId])
  @@map("ai_jobs")
}

/// Extracted text in PostgreSQL (D-025). No document body in logs.
model DocumentExtraction {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documentId     String       @unique @map("document_id") @db.Uuid
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  aiJobId        String?      @map("ai_job_id") @db.Uuid
  aiJob          AiJob?       @relation(fields: [aiJobId], references: [id], onDelete: SetNull)
  charCount      Int          @map("char_count")
  pageCount      Int?         @map("page_count")
  extractor      String
  textContent    String       @map("text_content") @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([organizationId, documentId])
  @@map("document_extractions")
}

/// Thin audit without document/prompt content (D-021 direction; Gate H later).
model AuditEvent {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  action         String
  objectType     String?       @map("object_type")
  objectId       String?       @map("object_id") @db.Uuid
  requestId      String?       @map("request_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}

/// Chat thread inside a Workspace (Phase 5A-1 / docs/32 §5.1, W-007).
model Conversation {
  id              String                 @id @default(uuid()) @db.Uuid
  organizationId  String                 @map("organization_id") @db.Uuid
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspaceId     String                 @map("workspace_id") @db.Uuid
  workspace       Workspace              @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  ownerUserId     String                 @map("owner_user_id") @db.Uuid
  owner           User                   @relation("ConversationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdByUserId String                 @map("created_by_user_id") @db.Uuid
  createdBy       User                   @relation("ConversationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  visibility      ConversationVisibility
  title           String?
  status          ConversationStatus     @default(ACTIVE)
  lastMessageAt   DateTime?              @map("last_message_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  messages         Message[]
  generations      AiGeneration[]
  contextSnapshots ContextSnapshot[]

  @@unique([organizationId, id])
  @@index([organizationId, workspaceId, lastMessageAt, id])
  @@index([organizationId, ownerUserId, status])
  @@map("conversations")
}

/// Append-only chat message (docs/32 §5.2). Edit/regenerate semantics wait on DEC-05.
model Message {
  id                 String        @id @default(uuid()) @db.Uuid
  organizationId     String        @map("organization_id") @db.Uuid
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  conversationId     String        @map("conversation_id") @db.Uuid
  conversation       Conversation  @relation(fields: [organizationId, conversationId], references: [organizationId, id], onDelete: Cascade)
  role               MessageRole
  content            String        @db.Text
  createdByUserId    String?       @map("created_by_user_id") @db.Uuid
  createdBy          User?         @relation("MessageCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  generationId       String?       @map("generation_id") @db.Uuid
  generation         AiGeneration? @relation("MessageFromGeneration", fields: [generationId], references: [id], onDelete: SetNull)
  clientMessageId    String?       @map("client_message_id")
  createdAt          DateTime      @default(now()) @map("created_at")
  generationsAsUser      AiGeneration[] @relation("GenerationUserMessage")
  generationsAsAssistant AiGeneration[] @relation("GenerationAssistantMessage")
  sources                MessageSource[]

  @@unique([organizationId, id])
  @@unique([conversationId, clientMessageId])
  @@index([organizationId, conversationId, createdAt, id])
  @@map("messages")
}

/// One AI generation attempt for a user message (docs/32 §5.3). Not the AIJob row.
model AiGeneration {
  id                     String             @id @default(uuid()) @db.Uuid
  organizationId         String             @map("organization_id") @db.Uuid
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  conversationId         String             @map("conversation_id") @db.Uuid
  conversation           Conversation       @relation(fields: [organizationId, conversationId], references: [organizationId, id], onDelete: Cascade)
  userMessageId          String             @map("user_message_id") @db.Uuid
  userMessage            Message            @relation("GenerationUserMessage", fields: [userMessageId], references: [id], onDelete: Restrict)
  assistantMessageId     String?            @map("assistant_message_id") @db.Uuid
  assistantMessage       Message?           @relation("GenerationAssistantMessage", fields: [assistantMessageId], references: [id], onDelete: SetNull)
  generationNumber       Int                @map("generation_number") @default(1)
  status                 AiGenerationStatus @default(queued)
  aiJobId                String?            @unique @map("ai_job_id") @db.Uuid
  aiJob                  AiJob?             @relation(fields: [aiJobId], references: [id], onDelete: SetNull)
  providerId             String?            @map("provider_id")
  modelId                String?            @map("model_id")
  promptVersion          String?            @map("prompt_version")
  inputHash              String?            @map("input_hash")
  supersedesGenerationId String?            @map("supersedes_generation_id") @db.Uuid
  supersedes             AiGeneration?      @relation("GenerationSupersedes", fields: [supersedesGenerationId], references: [id], onDelete: SetNull)
  supersededBy           AiGeneration[]     @relation("GenerationSupersedes")
  contextSnapshotId      String?            @unique @map("context_snapshot_id") @db.Uuid
  contextSnapshot        ContextSnapshot?   @relation("GenerationContextSnapshot", fields: [contextSnapshotId], references: [id], onDelete: SetNull)
  startedAt              DateTime?          @map("started_at")
  completedAt            DateTime?          @map("completed_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  resultMessages         Message[]          @relation("MessageFromGeneration")
  ownedContextSnapshot   ContextSnapshot?   @relation("SnapshotForGeneration")

  @@unique([organizationId, id])
  @@index([organizationId, conversationId, createdAt])
  @@index([userMessageId])
  @@map("ai_generations")
}

/// Provenance of one generation's model context (Phase 5B; conversation_only first).
/// Stores refs/hashes — not full document or prompt text (CTX-013 stays OPEN).
model ContextSnapshot {
  id                 String               @id @default(uuid()) @db.Uuid
  organizationId     String               @map("organization_id") @db.Uuid
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspaceId        String               @map("workspace_id") @db.Uuid
  workspace          Workspace            @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  conversationId     String               @map("conversation_id") @db.Uuid
  conversation       Conversation         @relation(fields: [organizationId, conversationId], references: [organizationId, id], onDelete: Cascade)
  aiGenerationId     String               @unique @map("ai_generation_id") @db.Uuid
  aiGeneration       AiGeneration         @relation("SnapshotForGeneration", fields: [aiGenerationId], references: [id], onDelete: Cascade)
  aiJobId            String?              @map("ai_job_id") @db.Uuid
  contextMode        String               @map("context_mode") @default("conversation_only")
  /// Ordered message ids and selection params — never full message bodies.
  contextManifest    Json                 @map("context_manifest")
  contextHash        String?              @map("context_hash")
  promptVersion      String?              @map("prompt_version")
  providerId         String?              @map("provider_id")
  modelId            String?              @map("model_id")
  inputTokenEstimate Int?                 @map("input_token_estimate")
  createdAt          DateTime             @default(now()) @map("created_at")
  items              ContextSnapshotItem[]
  generationLink     AiGeneration?        @relation("GenerationContextSnapshot")

  @@unique([organizationId, id])
  @@index([organizationId, conversationId, createdAt])
  @@map("context_snapshots")
}

model ContextSnapshotItem {
  id                 String                  @id @default(uuid()) @db.Uuid
  organizationId     String                  @map("organization_id") @db.Uuid
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contextSnapshotId  String                  @map("context_snapshot_id") @db.Uuid
  contextSnapshot    ContextSnapshot         @relation(fields: [contextSnapshotId], references: [id], onDelete: Cascade)
  ordinal            Int
  itemType           ContextSnapshotItemType @map("item_type")
  sourceEntityType   String                  @map("source_entity_type")
  sourceEntityId     String                  @map("source_entity_id") @db.Uuid
  /// Reserved for DocumentVersion; no FK until Phase 6A.
  sourceVersionId    String?                 @map("source_version_id") @db.Uuid
  contentHash        String?                 @map("content_hash")
  sourceLocator      Json?                   @map("source_locator")
  includedTokenEstimate Int?                 @map("included_token_estimate")
  citationKey        String?                 @map("citation_key")
  createdAt          DateTime                @default(now()) @map("created_at")
  messageSources     MessageSource[]

  @@unique([organizationId, id])
  @@unique([contextSnapshotId, ordinal])
  @@index([organizationId, contextSnapshotId])
  @@map("context_snapshot_items")
}

/// Server-validated citation links for an assistant message (never trust model-invented ids).
model MessageSource {
  id                    String               @id @default(uuid()) @db.Uuid
  organizationId        String               @map("organization_id") @db.Uuid
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  messageId             String               @map("message_id") @db.Uuid
  message               Message              @relation(fields: [organizationId, messageId], references: [organizationId, id], onDelete: Cascade)
  contextSnapshotItemId String               @map("context_snapshot_item_id") @db.Uuid
  contextSnapshotItem   ContextSnapshotItem  @relation(fields: [contextSnapshotItemId], references: [id], onDelete: Restrict)
  citationKey           String               @map("citation_key")
  rank                  Int
  sourceType            MessageSourceType    @map("source_type")
  pageStart             Int?                 @map("page_start")
  pageEnd               Int?                 @map("page_end")
  quoteLocator          Json?                @map("quote_locator")
  createdAt             DateTime             @default(now()) @map("created_at")

  @@unique([organizationId, id])
  @@unique([messageId, citationKey])
  @@index([organizationId, messageId])
  @@map("message_sources")
}

/// Transactional outbox for reliable queue publish (docs/15 §5.3; chat path docs/32 §8.1).
/// JOB-012 remains OPEN in journal — this is the scaffold shape for Phase 5A-2, not a status close.
model OutboxEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  eventType      String       @map("event_type")
  aggregateId    String       @map("aggregate_id") @db.Uuid
  /// Minimal JSON only (e.g. jobId + type). Never document/prompt text.
  payload        Json
  createdAt      DateTime     @default(now()) @map("created_at")
  publishedAt    DateTime?    @map("published_at")
  attemptCount   Int          @default(0) @map("attempt_count")
  lastError      String?      @map("last_error")
  nextAttemptAt  DateTime?    @map("next_attempt_at")

  @@index([publishedAt, nextAttemptAt, createdAt])
  @@index([organizationId, createdAt])
  @@index([aggregateId])
  @@map("outbox_events")
}
