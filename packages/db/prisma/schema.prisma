// Scaffold subset of docs/06-data-model.md + docs/12 (auth).
// Organization, Client, Matter, User, OrganizationMembership, Session.
// Session maps to AuthSession in docs/12; organizationId binds the actor org at login.
// workspace_id is optional (D-009) and has no foreign key until Workspace exists.
// MFA/SSO (O-008) is out of scope for this schema iteration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  active
  suspended

  @@map("organization_status")
}

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

enum MembershipRole {
  owner
  admin
  member

  @@map("membership_role")
}

enum MembershipStatus {
  active
  revoked

  @@map("membership_status")
}

model Organization {
  id           String                   @id @default(uuid()) @db.Uuid
  name         String
  status       OrganizationStatus       @default(active)
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")
  clients      Client[]
  matters      Matter[]
  memberships  OrganizationMembership[]
  sessions     Session[]

  @@map("organizations")
}

model Client {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  status         String       @default("active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  matters        Matter[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("clients")
}

model Matter {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clientId       String?      @map("client_id") @db.Uuid
  client         Client?      @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict)
  workspaceId    String?      @map("workspace_id") @db.Uuid
  title          String
  status         String       @default("active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("matters")
}

model User {
  id           String                   @id @default(uuid()) @db.Uuid
  email        String                   @unique
  passwordHash String                   @map("password_hash")
  status       UserStatus               @default(active)
  lastLoginAt  DateTime?                @map("last_login_at")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")
  memberships  OrganizationMembership[]
  sessions     Session[]

  @@map("users")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String           @map("user_id") @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  role           MembershipRole   @default(member)
  status         MembershipStatus @default(active)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

/// Opaque browser session; raw token never stored — only SHA-256 hash.
/// organizationId is the actor org bound at login (scaffold; not a full org-switcher).
model Session {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tokenHash      String       @unique @map("token_hash")
  expiresAt      DateTime     @map("expires_at")
  revokedAt      DateTime?    @map("revoked_at")
  lastSeenAt     DateTime?    @map("last_seen_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([userId])
  @@index([organizationId])
  @@map("sessions")
}
