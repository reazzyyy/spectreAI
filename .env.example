# Local development only. Do not put production secrets here.
# Migrator / owner (Prisma migrate, auth bootstrap, e2e seed). Not for tenant queries in production.
DATABASE_URL=postgresql://spectre:spectre@localhost:5432/spectre
# Runtime app role under RLS (created by workspace RLS migration). Local password only.
DATABASE_URL_RUNTIME=postgresql://spectre_app:spectre_app@localhost:5432/spectre
REDIS_URL=redis://localhost:6379
PORT=3000
# Nest origin for Next.js rewrite of /api/v1 (apps/web). Not a browser secret.
API_ORIGIN=http://localhost:3000
# Browser origin(s) allowed for cookie-mutating requests (W-014 Origin gate). Comma-separated.
WEB_ORIGIN=http://localhost:3001

# Dev-only first Organization + Owner (W-012). Never commit real passwords.
# Require BOOTSTRAP_DEV=1. Refused when NODE_ENV=production.
# BOOTSTRAP_DEV=1
# BOOTSTRAP_ORG_NAME=Dev Org
# BOOTSTRAP_OWNER_EMAIL=owner@localhost
# BOOTSTRAP_OWNER_PASSWORD=change-me-to-a-long-secret
# Playwright smoke (apps/web test:e2e). Org UUID from bootstrap:dev (or BOOTSTRAP_OUT_FILE JSON).
# E2E_ORGANIZATION_ID=
# Optional machine-readable bootstrap sink (CI): BOOTSTRAP_OUT_FILE=bootstrap.json
# Optional overrides (else BOOTSTRAP_OWNER_*):
# E2E_EMAIL=
# E2E_PASSWORD=

# Invitation TTL hours (O-011 — config, not a CONFIRMED product constant). Scaffold default 72.
# INVITE_TTL_HOURS=72

# Phase 3 local document storage root (scaffold; not production hoster / O-003).
# DOCUMENT_STORAGE_ROOT=.data/documents
